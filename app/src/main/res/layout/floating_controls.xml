<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#CC1B1B1F"
    android:padding="6dp" android:elevation="8dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton android:id="@+id/fPower"
        android:text="▶" android:layout_width="46dp" android:layout_height="44dp"
        app:cornerRadius="22dp" app:backgroundTint="#E53935"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fRot"
        android:text="⟳" android:layout_width="46dp" android:layout_height="44dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fZoomIn"
        android:text="＋" android:layout_width="46dp" android:layout_height="44dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fZoomOut"
        android:text="－" android:layout_width="46dp" android:layout_height="44dp"/>
  </LinearLayout>
  <GridLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:columnCount="3">
    <Space/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fUp"     android:text="▲" android:layout_width="44dp" android:layout_height="40dp"/>
    <Space/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fLeft"   android:text="◀" android:layout_width="44dp" android:layout_height="40dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fDown"   android:text="▼" android:layout_width="44dp" android:layout_height="40dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/fRight"  android:text="▶" android:layout_width="44dp" android:layout_height="40dp"/>
  </GridLayout>
</LinearLayout>
